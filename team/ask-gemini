#!/usr/bin/env bash
# Send one message to Gemini (Antigravity CLI) from this project and log both sides
# on team/BOARD.md. Usage:
#   team/ask-gemini [--new] [--from NAME] "message"      (or message on stdin)
# The conversation is continued across calls; --new starts a fresh one.
set -euo pipefail
here="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
root="$(dirname "$here")"
board="$here/BOARD.md"
convfile="$here/.gemini-conversation"
from="Claude"; new=0
while [ $# -gt 0 ]; do
  case "$1" in
    --new) new=1; shift ;;
    --from) from="$2"; shift 2 ;;
    *) break ;;
  esac
done
if [ $# -gt 0 ]; then msg="$*"; else msg="$(cat)"; fi
[ -n "$msg" ] || { echo "ask-gemini: empty message" >&2; exit 2; }
[ "${#msg}" -le 100000 ] || { echo "ask-gemini: message over 100000 bytes" >&2; exit 2; }
[ "$new" = 1 ] && rm -f "$convfile"
args=(--output-format json --print-timeout "${GEMINI_TIMEOUT:-900s}")
[ -n "${GEMINI_MODEL:-}" ] && args+=(--model "$GEMINI_MODEL")
[ -s "$convfile" ] && args+=(--conversation "$(cat "$convfile")")
stamp="$(date '+%Y-%m-%d %H:%M')"
printf '\n## %s · %s → Gemini\n\n%s\n' "$stamp" "$from" "$msg" >> "$board"
out="$(cd "$root" && env -u GEMINI_API_KEY -u GOOGLE_API_KEY agy "${args[@]}" -p="$msg" </dev/null)" || {
  printf '\n## %s · (no reply: agy failed)\n' "$(date '+%Y-%m-%d %H:%M')" >> "$board"
  echo "ask-gemini: agy failed" >&2; printf '%s\n' "$out" >&2; exit 1; }
reply="$(printf '%s' "$out" | python3 -c 'import sys,json; d=json.load(sys.stdin); print(d.get("response","").rstrip())')"
conv="$(printf '%s' "$out" | python3 -c 'import sys,json; print(json.load(sys.stdin).get("conversation_id",""))')"
[ -n "$conv" ] && printf '%s' "$conv" > "$convfile"
printf '\n## %s · Gemini → %s\n\n%s\n' "$(date '+%Y-%m-%d %H:%M')" "$from" "$reply" >> "$board"
printf '%s\n' "$reply"
